AWS_ACCESS_KEY_ID=KEY
AWS_SECRET_ACCESS_KEY=KEY

STRIPE_SK=KEY
STRIPE_WEBHOOK_SECRET=KEY

SENTRY_DSN=VAL

AI_PROVIDER=openrouter
AI_MODEL_WEBPAGE=google/gemini-2.5-flash-lite
AI_MODEL_TEXT=google/gemini-2.5-flash-lite
AI_MODEL_OCR=google/gemini-2.5-flash
AI_MODEL_DOCUMENT=google/gemini-2.5-flash
AI_MODEL_VISION=anthropic/claude-sonnet-4.6
AI_MODEL_MODERATION=google/gemini-2.5-flash
AI_MODEL_NUTRITION=google/gemini-2.5-flash-lite
AI_MODEL_ASSISTANT=anthropic/claude-sonnet-4.6
AI_MODEL_ASSISTANT_LOW=google/gemini-2.5-flash

# Smart pantry (optional): Grocy stock engine connection
GROCY_URL=http://grocy:80/
GROCY_API_KEY=KEY
# Barcode Buddy image tag is per-architecture: v1.8.1.5 (amd64) or
# arm64v8-v1.8.1.5 (Raspberry Pi)
BARCODEBUDDY_TAG=v1.8.1.5

# Communal recipe library (optional, default off): when "true", EVERY authenticated
# user on this instance can view, edit and delete EVERY recipe, regardless of who
# owns it. Existing and future recipes are covered. Only enable on a trusted
# single-household selfhost deployment. Bulk "delete all my recipes" stays scoped
# to the caller.
ENABLE_COMMUNAL_RECIPE_LIBRARY=false

GOOGLE_GSI_CLIENT_ID=VAL
GOOGLE_GSI_CLIENT_SECRET=VAL

API_PUBLIC_BASE_URL=https://example.com
